#!/usr/bin/env bash
# source: https://github.com/ThePrimeagen/.dotfiles with some modifications

if [[ $# -eq 1 ]]; then
  selected=$1
else
  # Hardcoded folders to always include
  declare -a hardcoded_folders=(
    "${HOME}/.config/opencode"
    "${HOME}/Documents/ledger"
    # Add more hardcoded folders here
  )

  # Find folders in ~/Code
  session_folders="$(find ~/Code -mindepth 2 -maxdepth 2 -type d 2> /dev/null)"

  # Build the list: hardcoded folders + find results
  all_folders=""
  for folder in "${hardcoded_folders[@]}"; do
    if [[ -d "$folder" ]]; then
      all_folders+="$folder"$'\n'
    fi
  done
  all_folders+="$session_folders"

  selected="$(echo "$all_folders" | fzf)"
fi

if [[ -z $selected ]]; then
  exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
  tmux new-session -s "$selected_name" -c "$selected"
  exit 0
fi

if ! tmux has-session -t="$selected_name" 2> /dev/null; then
  tmux new-session -ds "$selected_name" -c "$selected"
fi

tmux switch-client -t "$selected_name" || tmux a -t "$selected_name"
